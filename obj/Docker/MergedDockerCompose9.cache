name: dockercompose6979990421899148574
services:
  razor-ticket-booking-system:
    build:
      context: C:\Users\haons211\Documents\razor-ticket-booking-system
      dockerfile: razor-ticket-booking-system/Dockerfile
    container_name: ticket-system-app
    depends_on:
      ticket-system-db:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      ConnectionStrings__DefaultConnection: Server=tcp:ticket-system-db,1433;Database=RazorDB;User Id=sa;Password=YourStrong@Passw0rd;
    image: razorticketbookingsystem
    networks:
      app-network: null
    ports:
      - mode: ingress
        target: 80
        published: "9090"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    restart: always
    volumes:
      - type: bind
        source: C:\Users\haons211\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\haons211\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  ticket-system-db:
    container_name: ticket-system-db
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: YourStrong@Passw0rd
    image: mcr.microsoft.com/mssql/server:2022-latest
    networks:
      app-network: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
    restart: always
networks:
  app-network:
    name: dockercompose6979990421899148574_app-network
    driver: bridge